{
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/index?__route=:route*"
    },
    {
      "source": "/((?!api/|assets/|data/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "data/medilink_store.json"
    }
  }
}
