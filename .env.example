# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_CHAT_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-only Supabase transaction-pooler connection for medilink_runtime.
# Never prefix this with VITE_ or expose it to browser code.
# Omit only for isolated local JSON development/test runs.
SUPABASE_DATABASE_URL=""

# Optional credentials for the seeded demo accounts. Use unique passwords of
# at least 12 characters; never commit your populated .env file.
DEMO_PATIENT_PASSWORD=""
CLINICIAN_PASSWORD=""
ADMIN_PASSWORD=""
# Temporary Vercel demonstration clinician (do not use for real clinical data).
DEMO_CLINICIAN_PASSWORD=""
DEMO_CLINICIAN_SESSION_SECRET=""
DEMO_CLINICIAN_EXPIRES_AT=""
